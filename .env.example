# ===== 기관 정보 =====
IRB_INSTITUTION_NAME=○○대학교병원
IRB_COMMITTEE_NAME=○○대학교병원 기관생명윤리위원회

# ===== 보안 (운영 시 반드시 변경) =====
# 세션 서명 키: python -c "import secrets; print(secrets.token_hex(32))"
# PostgreSQL 사용 시 비워 두면 최초 생성값을 DB(app_secrets)에 보관해 재배포 후에도 유지한다
IRB_SECRET_KEY=change-me
# 가명처리 HMAC 키(추가정보). 처리 서버와 분리된 곳(HSM/별도 키관리 서버)에 보관 권장
IRB_PSEUDONYM_SECRET=change-me-too
# 비밀번호 해시(PBKDF2-SHA256) 반복 횟수
IRB_PASSWORD_ITERATIONS=310000
# HTTPS 환경이면 true (세션 쿠키 Secure 속성)
IRB_SESSION_HTTPS_ONLY=false

# ===== 저장소 =====
IRB_DATA_DIR=./data
# 신규 공용 IRB 과제 등록을 끄려면 false로 설정
IRB_PUBLIC_IRB_ENABLED=true
# 운영(Vercel 포함)은 PostgreSQL. 비우면 DATABASE_URL → POSTGRES_URL(Vercel Postgres 연동 시 자동 주입) → 로컬 SQLite 순으로 사용
# postgres:// · postgresql:// 주소는 자동으로 postgresql+psycopg:// 로 바뀐다
# IRB_DATABASE_URL=postgresql+psycopg://irb:password@db:5432/irb
# 업로드 원본을 DB(stored_files)에도 보관해 재배포 후 복원: db | disk (기본: PostgreSQL이면 db)
# IRB_FILE_STORE=db
# 연결 풀 크기(서버리스 PostgreSQL은 연결 수 제한이 작음)
# IRB_DB_POOL_SIZE=5
# IRB_DB_MAX_OVERFLOW=5
# 기관 SOP에 맞춘 규칙 파일 경로
# IRB_RULESET_PATH=/etc/irb/ruleset.yaml
# 서류 품질 점검 기준 파일(기관용 사본, 비우면 기본값)
IRB_QC_CRITERIA_PATH=

# ===== 업무 정책 =====
IRB_APPROVAL_VALIDITY_DAYS=365
IRB_REVIEWER_DUE_DAYS=14
IRB_MAX_UPLOAD_MB=50
IRB_SCHEDULER_ENABLED=true
IRB_SCHEDULER_INTERVAL=3600

# ===== 시스템 연동 (CDW/데이터 추출 시스템 → 승인 확인 API) =====
# IRB_INTEGRATION_TOKEN=

# ===== (선택) AI 사전검토 보조 - 외부 API 전송이므로 기관 승인 후 활성화 =====
IRB_AI_REVIEW_ENABLED=false
# IRB_AI_ENABLED=true 도 같은 의미(사전검토 보조 + 문서 OCR·추출·분류·요약 전체)
IRB_AI_MODEL=claude-opus-5-5
IRB_AI_PROVIDER=anthropic
# OpenRouter 무료 모델은 더미 데이터 전용. IRB_AI_PROVIDER=openrouter로 선택.
# OPENROUTER_API_KEY=
# 계정별 AI: 관리자(admin)는 Anthropic API의 Claude, 그 밖의 계정(guest 등)은 OpenRouter 무료 모델
# CLAUDE_API_KEY=
IRB_AI_ADMIN_MODEL=claude-sonnet-5-5
# 서버 시작 시 기본 계정(guest, admin) 확인·자동 생성. 비밀번호는 운영에서 반드시 변경
IRB_BUILTIN_ACCOUNTS=true
# 최초 생성용. 기본 계정이 활성화된 경우 비워 두면 medilux_super_admin을 사용합니다.
# 운영에 사용할 초기 비밀번호는 별도로 설정합니다. 기존 계정의 비밀번호는 재시작 시 유지됩니다.
IRB_SUPER_ADMIN_PASSWORD=
# IRB_GUEST_PASSWORD=
# IRB_ADMIN_PASSWORD=
IRB_AI_OCR_MAX_PAGES=20
# AI 호출 1회의 전체 제한 시간(초). 넘기면 규칙 기반 결과만으로 채점
IRB_AI_TIMEOUT=420
# 로컬 실행(python -m irb_automation serve)은 작업 디렉터리의 .env를 자동으로 읽는다. 끄려면 false
# IRB_LOAD_DOTENV=true

# ===== 문서 자동화 파이프라인 =====
# 서류 업로드 시 자동 분석(인식·분류·개인정보 점검·추출·정합성). AI 단계는 AI 활성 시에만
IRB_AI_PIPELINE_AUTO=true
# AI로 원본 파일(PDF·이미지)을 보낼 수 있는 서류 종류(개인정보 탐지 시에는 전송하지 않음)
IRB_AI_DOC_TYPES_ALLOWED=protocol,application,crf,deid_plan
# LibreOffice 실행 파일(DOC·RTF·ODT 인식, PDF 변환). 비워 두면 PATH에서 자동 탐지
# IRB_SOFFICE_PATH=/usr/bin/soffice
# 분석을 요청 처리 중에 동기 실행(디버그용)
IRB_PIPELINE_SYNC=false
# ANTHROPIC_API_KEY=

# ===== 이메일 알림 (선택) =====
# IRB_SMTP_HOST=smtp.hospital.local
# IRB_SMTP_PORT=587
# IRB_SMTP_STARTTLS=true
# IRB_SMTP_USER=
# IRB_SMTP_PASSWORD=
# IRB_SMTP_FROM=irb-noreply@hospital.local
# 메일 본문 바로가기 링크의 기준 주소
# IRB_BASE_URL=https://irb.hospital.local

# ===== 사전 대상자 수 조회 데이터 원천 =====
# OMOP CDM DB (person, condition_occurrence 테이블 사용). 미설정 시 합성 데이터 CSV 사용
# IRB_CDW_URL=postgresql+psycopg://reader:password@cdw:5432/omop
# IRB_CDW_SCHEMA=cdm
# IRB_CDW_DEMO_CSV=./samples/synthetic_patients.csv

# 테스트 전용: 로그인 화면 없이 자동 로그인(운영에서는 비워 둘 것)
IRB_AUTO_LOGIN_USER=
