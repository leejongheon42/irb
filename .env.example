# ===== 기관 정보 =====
IRB_INSTITUTION_NAME=○○대학교병원
IRB_COMMITTEE_NAME=○○대학교병원 기관생명윤리위원회

# ===== 보안 (운영 시 반드시 변경) =====
# 세션 서명 키: python -c "import secrets; print(secrets.token_hex(32))"
IRB_SECRET_KEY=change-me
# 가명처리 HMAC 키(추가정보). 처리 서버와 분리된 곳(HSM/별도 키관리 서버)에 보관 권장
IRB_PSEUDONYM_SECRET=change-me-too
# 비밀번호 해시(PBKDF2-SHA256) 반복 횟수
IRB_PASSWORD_ITERATIONS=310000
# HTTPS 환경이면 true (세션 쿠키 Secure 속성)
IRB_SESSION_HTTPS_ONLY=false

# ===== 저장소 =====
IRB_DATA_DIR=./data
# 기본은 SQLite. 운영 시 PostgreSQL 권장 (psycopg 설치 필요)
# IRB_DATABASE_URL=postgresql+psycopg://irb:password@db:5432/irb
# 기관 SOP에 맞춘 규칙 파일 경로
# IRB_RULESET_PATH=/etc/irb/ruleset.yaml

# ===== 업무 정책 =====
IRB_APPROVAL_VALIDITY_DAYS=365
IRB_REVIEWER_DUE_DAYS=14
IRB_MAX_UPLOAD_MB=50
IRB_SCHEDULER_ENABLED=true
IRB_SCHEDULER_INTERVAL=3600

# ===== 시스템 연동 (CDW/데이터 추출 시스템 → 승인 확인 API) =====
# IRB_INTEGRATION_TOKEN=

# ===== (선택) AI 사전검토 보조 - 외부 API 전송이므로 기관 승인 후 활성화 =====
IRB_AI_REVIEW_ENABLED=false
IRB_AI_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=
